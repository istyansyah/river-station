# ══════════════════════════════════════════════════════════════
# Environment Variables — River Station Backend
# Copy to .env and fill in your values before running.
# ══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
APP_NAME="River Station API"
APP_VERSION="1.0.0"
DEBUG=false

# ── MQTT Broker ───────────────────────────────────────────────
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_WEATHER=river/weather
MQTT_TOPIC_HEARTBEAT=river/heartbeat
MQTT_TOPIC_COMMAND=riverstation/device/cmd
MQTT_CLIENT_ID=river-backend-01

# ── InfluxDB ──────────────────────────────────────────────────
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=river-station
INFLUXDB_BUCKET=river_monitoring

# ── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
TELEGRAM_ENABLED=true

# ── Relative Water Level Configuration ────────────────────────
# Water level is the increase from normal river conditions (cm)
NORMAL_DISTANCE_CM=180.0
MEASUREMENT_METHOD=relative
WARNING_WATER_LEVEL_INCREASE_CM=30.0
DANGER_WATER_LEVEL_INCREASE_CM=60.0
CRITICAL_WATER_LEVEL_INCREASE_CM=90.0

# Heat index thresholds (°C)
WARNING_HEAT_INDEX_C=32.2
DANGER_HEAT_INDEX_C=39.4
CRITICAL_HEAT_INDEX_C=51.7

# Wind speed thresholds (km/h)
WARNING_WIND_SPEED_KMH=45.0
DANGER_WIND_SPEED_KMH=65.0

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
